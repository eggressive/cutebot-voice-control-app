<?xml version="1.0" encoding="utf-8"?>
<!--
  Disable cloud backup and device-to-device transfers for all app data.
  The Vosk speech models are huge binaries and should never be backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
